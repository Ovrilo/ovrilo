{
  "name": "ovrilo",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "api:sync": "node scripts/sync-openapi.mjs",
    "licenses": "node scripts/licenses.mjs",
    "api:generate": "openapi-typescript api/ovrilo-api.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "release:build": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.104.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "2.6.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "livekit-client": "2.22.3",
    "lucide-react": "1.49.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.4"
  }
}
