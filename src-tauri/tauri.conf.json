{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ovrilo",
  "version": "0.8.0",
  "identifier": "app.ovrilo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ovrilo",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5158 ws://localhost:5158 http://127.0.0.1:9000 ws://127.0.0.1:7880 http://127.0.0.1:7880"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRjg3OTVFMDA1NzgxREMKUldUY2dWY0FYbm40VHdvbE5mOVNDWEhSeXNVd01BemlrNmtEVzNtcS9zMGJXNGdiUkwxa3h4V2kK",
      "endpoints": [
        "https://github.com/Ovrilo/ovrilo-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ovrilo"
        ]
      }
    }
  }
}
